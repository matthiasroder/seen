/dist/
/logs/
/native/launch-host
com.seen.archive.json
/mobile-state*/
/mobile/apple/build/
xcuserdata/
*.xcuserstate
*.mobileprovision

# Local build/runtime state.
.DS_Store
node_modules/
__pycache__/
*.py[cod]
*.lock

